# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must NEVER be committed. This example file is safe
# to commit because it contains no real secrets — it documents the shape only.

# --- MongoDB Atlas ---
# Atlas -> Database -> Connect -> Drivers -> Python
# Paste the string and replace <db_password> with the real password.
MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net"

# Database name inside the cluster. Created automatically on first write.
MONGODB_DB="nexora"

# --- LLM provider ---
# Only one of these is needed, depending on the provider chosen.
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
VOYAGE_API_KEY=""
